# =============================================================================
# Indy Ledger VM — .env template (copy to `.env` ON THE VM; never commit real
# values). deploy-ledger-vm.sh generates strong random secrets automatically.
# =============================================================================

# ACA-Py wallet encryption keys (strong random values).
ISSUER_WALLET_KEY=change-me-issuer-wallet-key
VERIFIER_WALLET_KEY=change-me-verifier-wallet-key

# Admin API key protecting :8001 / :8011 (Cloud Run sends X-API-KEY).
ACAPY_ADMIN_API_KEY=change-me-strong-admin-api-key

# Public DIDComm endpoints — MUST be the VM external IP so wallets can reach it.
ISSUER_ENDPOINT=http://VM_EXTERNAL_IP:8000
VERIFIER_ENDPOINT=http://VM_EXTERNAL_IP:8010

# Trust Anchor seed used by ledger/setup.py (32 chars). MVP default below.
ISSUER_SEED=000000000000000000000000Steward1
